# 复制为 /etc/samba/samba-ui.env 并执行 chmod 600。
# 修改后执行 systemctl restart samba-ui。

# 开启 Basic 认证（两项必须同时设置）。
SAMBA_UI_USER=admin
SAMBA_UI_PASSWORD=请改成强口令

# 可选：监听地址与端口。默认只监听回环地址。
# SAMBA_UI_BIND=0.0.0.0
# SAMBA_UI_PORT=8080

# 可选：保存后的重载命令，留空或注释掉表示不重载。
# SAMBA_UI_RELOAD=smbcontrol all reload-config

# 可选：语法校验程序路径；设为空字符串可关闭校验。
# SAMBA_UI_TESTPARM=testparm

# 可选：反向代理改写了 Host 时，显式允许浏览器的访问地址（逗号分隔）。
# SAMBA_UI_ALLOW_ORIGINS=http://nas:8080
